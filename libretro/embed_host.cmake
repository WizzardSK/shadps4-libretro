# Turns the launcher (host_main.c, built as an executable) into a C array the libretro core
# carries and runs from memory: cmake -DINPUT=<executable> -DOUTPUT=<.c file> -P embed_host.cmake

file(READ "${INPUT}" host_hex HEX)
string(LENGTH "${host_hex}" host_hex_length)
math(EXPR host_size "${host_hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," host_bytes "${host_hex}")
file(WRITE "${OUTPUT}"
"/* Generated by libretro/embed_host.cmake from the launcher's executable. */
const unsigned char g_libretro_host[] = {${host_bytes}};
const unsigned long g_libretro_host_size = ${host_size};
")
